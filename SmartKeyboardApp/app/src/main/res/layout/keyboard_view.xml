<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_bg_dark"
    android:paddingBottom="6dp">

    <!-- TOP TOOLBAR: Secondary functions (AI, Punctuation, Camera, Translate, Voice, Toggle Numbers, Settings) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none"
        android:background="#16181B">

        <LinearLayout
            android:id="@+id/toolbar_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:orientation="horizontal">

            <!-- AI Button (DeepSeek) -->
            <Button
                android:id="@+id/btn_ai_menu"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="✨ DeepSeek"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/accent_amber"
                android:layout_marginEnd="4dp" />

            <!-- Quick Auto-Punctuation Button (1 РЕЖИМ) -->
            <Button
                android:id="@+id/btn_auto_punctuate"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text=".,?! Знаки"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/accent_blue"
                android:layout_marginEnd="4dp" />

            <!-- Translator -->
            <ImageButton
                android:id="@+id/btn_translate"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/accent_emerald"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="4dp" />

            <!-- Camera OCR / Smart Lens -->
            <ImageButton
                android:id="@+id/btn_camera"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_camera"
                android:tint="@color/accent_purple"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="4dp" />

            <!-- Voice Input -->
            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:tint="@color/accent_rose"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="4dp" />

            <!-- Number Row Toggle (Like screen 1) -->
            <Button
                android:id="@+id/btn_toggle_numbers"
                android:layout_width="42dp"
                android:layout_height="34dp"
                android:text="123"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_amber"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="4dp" />

            <!-- Settings -->
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="36dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="@color/kb_text_muted"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- OPTIONAL NUMBER ROW: 1 2 3 4 5 6 7 8 9 0 (AS ON SCREEN 1) -->
    <LinearLayout
        android:id="@+id/row_numbers"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:weightSum="10"
        android:paddingHorizontal="2dp"
        android:layout_marginTop="2dp" />

    <!-- ROW 1 LETTERS (й ц у к е н г ш щ з х ъ) -->
    <LinearLayout
        android:id="@+id/row_letters_1"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:layout_marginTop="3dp" />

    <!-- ROW 2 LETTERS (ф ы в а п р о л д ж э) -->
    <LinearLayout
        android:id="@+id/row_letters_2"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp" />

    <!-- ROW 3 LETTERS (Shift, я ч с м и т ь б ю, Backspace) -->
    <LinearLayout
        android:id="@+id/row_letters_3"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:layout_marginTop="4dp" />

    <!-- ROW 4 BOTTOM (Sym, Lang, Space, Dot, Enter) -->
    <LinearLayout
        android:id="@+id/row_bottom"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:layout_marginTop="4dp" />

</LinearLayout>
